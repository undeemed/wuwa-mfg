+inline void AttachCommandList(ID3D12GraphicsCommandList* commands)
+{
+    if(!state || !state->enabled || !commands)return;
+    std::lock_guard lock(state->mutex);
+    const auto legacy=(*reinterpret_cast<void***>(commands))[26];
+    if(originalLegacy)
+    {
+        if(legacy!=legacyTarget)
+        { state->coverageGap=true;Event({{"kind","barrier_coverage_gap"},{"reason","different legacy implementation"}}); }
+        return;
+    }
+    Microsoft::WRL::ComPtr<ID3D12GraphicsCommandList7> newer;
+    const auto newerResult=commands->QueryInterface(IID_PPV_ARGS(&newer));
+    legacyTarget=legacy;originalLegacy=reinterpret_cast<LegacyBarrierFn>(legacy);
+    if(SUCCEEDED(newerResult))
+    {
+        enhancedTarget=(*reinterpret_cast<void***>(newer.Get()))[80];
+        originalEnhanced=reinterpret_cast<EnhancedBarrierFn>(enhancedTarget);
+    }
+    auto error=DetourTransactionBegin();
+    if(error==NO_ERROR)
+    {
+        error=DetourUpdateThread(GetCurrentThread());
+        if(error==NO_ERROR)error=DetourAttach(reinterpret_cast<PVOID*>(&originalLegacy),LegacyBarriers);
+        if(error==NO_ERROR && originalEnhanced)error=DetourAttach(reinterpret_cast<PVOID*>(&originalEnhanced),EnhancedBarriers);
+        if(error==NO_ERROR)error=DetourTransactionCommit();else DetourTransactionAbort();
+    }
+    if(error!=NO_ERROR){originalLegacy=nullptr;originalEnhanced=nullptr;}
+    Event({{"kind","barrier_hooks"},{"status",error},{"legacy",originalLegacy!=nullptr},{"enhanced",originalEnhanced!=nullptr},
+        {"scope","observed command-list implementations only; no implicit state tracking"}});
+}
+inline void DetachCommandList()
+{
+    if(!originalLegacy)return;
+    DetourTransactionBegin();DetourUpdateThread(GetCurrentThread());
+    DetourDetach(reinterpret_cast<PVOID*>(&originalLegacy),LegacyBarriers);
+    if(originalEnhanced)DetourDetach(reinterpret_cast<PVOID*>(&originalEnhanced),EnhancedBarriers);
+    if(DetourTransactionCommit()==NO_ERROR){originalLegacy=nullptr;originalEnhanced=nullptr;}
+}
