+$build = Join-Path ([IO.Path]::GetTempPath()) ('nr-dispatch-slots-' + [guid]::NewGuid())
+New-Item -ItemType Directory -Path $build | Out-Null
+Set-Content -LiteralPath (Join-Path $build 'pch.h') -Value '// Isolated production helper.'
+Set-Content -LiteralPath (Join-Path $build 'Util.h') -Value '#include <unknwn.h>
+namespace Util { inline bool CheckForRealObject(const char*, IUnknown*, IUnknown**) { return false; } }'
+if ($LegacyControl) {
+    New-Item -ItemType Directory -Path (Join-Path $build 'dlssnr') | Out-Null
+    $header = Get-Content -LiteralPath (Join-Path $repo 'OptiScaler/dlssnr/DlssNr_DispatchSlots.h') -Raw
+    # Negative control reproduces the original unchecked wrapping allocator.
+    $header.Replace('if (Busy(index)) continue;', '// Original ring ignored in-flight ownership.') | Set-Content -LiteralPath (Join-Path $build 'dlssnr/DlssNr_DispatchSlots.h')
+}
+& cl.exe /nologo /std:c++20 /EHsc /W4 /DNOMINMAX "/I$build" "/I$repo/OptiScaler" "/Fo$build/" "/Fe$build/smoke.exe" `
+    "$PSScriptRoot/nr_dispatch_slots_smoke.cpp" "$repo/OptiScaler/dlssnr/DlssNr_GpuLifetime.cpp" d3d12.lib dxgi.lib ole32.lib
+if ($LASTEXITCODE -ne 0) { throw 'Slot regression compilation failed.' }
+& "$build/smoke.exe"
+if ($LegacyControl) {
+    if ($LASTEXITCODE -eq 0) { throw 'Negative control unexpectedly passed.' }
+    Write-Output 'Negative control failed as expected.'
+} elseif ($LASTEXITCODE -ne 0) { throw 'Slot regression failed.' }
