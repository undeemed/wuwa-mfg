diff --git a/tests/nr_dispatch_slots_smoke.cpp b/tests/nr_dispatch_slots_smoke.cpp
new file mode 100644
index 0000000..d01e5a2
--- /dev/null
+++ b/tests/nr_dispatch_slots_smoke.cpp
@@ -0,0 +1,62 @@
+// Isolated WARP regression using production slot allocation and completion tracking.
+#include <windows.h>
+#include <d3d12.h>
+#include <dxgi1_4.h>
+#include <wrl/client.h>
+#include <cstdio>
+#include <stdexcept>
+#include <dlssnr/DlssNr_DispatchSlots.h>
+#include <dlssnr/DlssNr_GpuLifetime.h>
+using Microsoft::WRL::ComPtr;
+static void check(HRESULT hr) { if (FAILED(hr)) throw std::runtime_error("D3D12 call failed"); }
+static void expect(bool ok, const char* why) { if (!ok) throw std::runtime_error(why); }
+int main() try
+{
+    ComPtr<IDXGIFactory4> factory; ComPtr<IDXGIAdapter> adapter; ComPtr<ID3D12Device> device;
+    check(CreateDXGIFactory1(IID_PPV_ARGS(&factory)));
+    check(factory->EnumWarpAdapter(IID_PPV_ARGS(&adapter)));
+    check(D3D12CreateDevice(adapter.Get(), D3D_FEATURE_LEVEL_11_0, IID_PPV_ARGS(&device)));
+    ComPtr<ID3D12CommandQueue> queue; D3D12_COMMAND_QUEUE_DESC desc {};
+    check(device->CreateCommandQueue(&desc, IID_PPV_ARGS(&queue)));
+    ComPtr<ID3D12CommandAllocator> allocator; ComPtr<ID3D12GraphicsCommandList> commands;
+    check(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&allocator)));
+    check(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, allocator.Get(), nullptr, IID_PPV_ARGS(&commands)));
+    check(commands->Close()); ID3D12CommandList* lists[] { commands.Get() };
+    DlssNr::GpuLifetime life; DlssNr::DispatchSlots<96> slots;
+    auto fill = [&] {
+        for (unsigned i = 0; i < 96; ++i) {
+            auto slot = slots.Acquire(); expect(slot.has_value(), "free slot missing");
+            life.Record(commands.Get());
+            life.Retire([done=slot->completion] { done->store(true); });
+        }
+    };
+    fill();
+    expect(!slots.Acquire(), "97th allocation reused a live descriptor/constants slot");
+    for (unsigned i=0; i<1000; ++i) life.Collect();
+    expect(!slots.Acquire(), "CPU progress made unsubmitted descriptors reusable");
+    life.ResetRecording(commands.Get()); fill();
+    ComPtr<ID3D12Fence> gate, drain;
+    check(device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&gate)));
+    check(device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&drain)));
+    check(queue->Wait(gate.Get(), 1)); queue->ExecuteCommandLists(1, lists);
+    life.Submitted(queue.Get(), 1, lists); life.ResetRecording(commands.Get());
+    const bool blockedWasSafe = !slots.Acquire();
+    // Always unblock the isolated software queue before reporting a failure.
+    check(gate->Signal(1)); check(queue->Signal(drain.Get(), 1));
+    HANDLE event=CreateEventW(nullptr,FALSE,FALSE,nullptr);
+    check(drain->SetEventOnCompletion(1,event));
+    const auto waited=WaitForSingleObject(event,5000); CloseHandle(event);
+    expect(waited==WAIT_OBJECT_0,"WARP queue did not drain");
+    expect(blockedWasSafe,"reset recycled descriptors while submitted work was blocked");
+    life.Collect(); fill();
+    queue->ExecuteCommandLists(1, lists); life.Submitted(queue.Get(),1,lists);
+    check(queue->Signal(drain.Get(),2));
+    event=CreateEventW(nullptr,FALSE,FALSE,nullptr); check(drain->SetEventOnCompletion(2,event));
+    const auto waitedAgain=WaitForSingleObject(event,5000); CloseHandle(event);
+    expect(waitedAgain==WAIT_OBJECT_0,"second WARP drain failed");
+    life.Collect(); expect(!slots.Acquire(),"completed but replayable list lost its descriptors");
+    life.ResetRecording(commands.Get()); life.Collect();
+    expect(slots.Acquire().has_value(),"completed closed recording did not release descriptors");
+    std::puts("PASS: 96-slot overflow, unsubmitted work, blocked GPU after reset, replay, and completed reuse");
+    return 0;
+} catch (const std::exception& e) { std::fprintf(stderr,"FAIL: %s\n",e.what()); return 1; }
diff --git a/tests/nr_working_extent_smoke.cpp b/tests/nr_working_extent_smoke.cpp
new file mode 100644
index 0000000..f956bf9
--- /dev/null
+++ b/tests/nr_working_extent_smoke.cpp
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#include "../OptiScaler/dlssnr/DlssNr_WorkingExtent.h"
+#include <cassert>
+#include <limits>
+#include <iostream>
+int main()
+{
+    using DlssNr::ResolveWorkingExtent;
+    auto full = ResolveWorkingExtent(2562, 1442, 3840, 2160, 1.0f, true);
+    assert(full && full->width == 3840 && full->height == 2160 && full->sourceScale > 1 && full->outputRelative);
+    auto smaller = ResolveWorkingExtent(1920, 1080, 3840, 2160, 0.75f, true);
+    assert(smaller->width == 2880 && smaller->height == 1620);
+    auto drs = ResolveWorkingExtent(1280, 720, 3840, 2160, 0.75f, true);
+    assert(drs->width == smaller->width && drs->height == smaller->height);
+    auto half = ResolveWorkingExtent(2562, 1442, 3840, 2160, 0.5f, true);
+    assert(half->width == 1920 && half->height == 1080 && half->sourceScale < 1);
+    auto legacy = ResolveWorkingExtent(2562, 1442, 3840, 2160, 0.5f, false);
+    assert(legacy->width == 1281 && legacy->height == 721 && !legacy->outputRelative);
+    auto missing = ResolveWorkingExtent(2562, 1442, 0, 2160, 1.0f, true);
+    assert(missing->width == 2562 && missing->height == 1442 && !missing->outputRelative);
+    auto invalid = ResolveWorkingExtent(2562, 1442, 3840, 2160, std::numeric_limits<float>::quiet_NaN(), true);
+    assert(invalid->width == 3840 && invalid->height == 2160);
+    auto tiny = ResolveWorkingExtent(1, 1, 0, 0, -1, true);
+    assert(tiny->width == 1 && tiny->height == 1);
+    auto limited = ResolveWorkingExtent(2562, 1442, 16384, 8192, 2, true);
+    assert(limited->width == 16384 && limited->height == 8192);
+    auto ultrawide = ResolveWorkingExtent(2294, 960, 3440, 1440, 0.75f, true);
+    assert(ultrawide->width == 2580 && ultrawide->height == 1080);
+    assert(!ResolveWorkingExtent(0, 1442, 3840, 2160, 1, true));
+    std::cout << "NR output-relative extent regression passed\n";
+}
