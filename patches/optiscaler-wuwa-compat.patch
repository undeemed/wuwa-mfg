diff --git a/OptiScaler/dlssnr/DlssNr_DispatchSlots.h b/OptiScaler/dlssnr/DlssNr_DispatchSlots.h
new file mode 100644
index 0000000..505fb62
--- /dev/null
+++ b/OptiScaler/dlssnr/DlssNr_DispatchSlots.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <optional>
+
+namespace DlssNr
+{
+// Owner serializes allocation. Completion may be delivered from a queue/reset notification.
+// A slot contains both GPU-visible descriptors and mapped upload constants.
+template <uint32_t Count> class DispatchSlots
+{
+    static_assert(Count > 0);
+    std::array<std::shared_ptr<std::atomic_bool>, Count> ready {};
+    uint32_t next = 0;
+  public:
+    struct Allocation { uint32_t index; std::shared_ptr<std::atomic_bool> completion; };
+    bool Busy(uint32_t index) const
+    { return index < Count && ready[index] && !ready[index]->load(); }
+    std::optional<Allocation> Acquire()
+    {
+        for (uint32_t offset = 0; offset < Count; ++offset)
+        {
+            const auto index = (next + offset) % Count;
+            if (Busy(index)) continue;
+            auto completion = std::make_shared<std::atomic_bool>(false);
+            ready[index] = completion;
+            next = (index + 1) % Count;
+            return Allocation { index, std::move(completion) };
+        }
+        return std::nullopt;
+    }
+};
+}
