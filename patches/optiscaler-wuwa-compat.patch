diff --git a/OptiScaler/dlssnr/DlssNr_WorkingExtent.h b/OptiScaler/dlssnr/DlssNr_WorkingExtent.h
new file mode 100644
index 0000000..af45cf2
--- /dev/null
+++ b/OptiScaler/dlssnr/DlssNr_WorkingExtent.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+
+namespace DlssNr
+{
+struct WorkingExtent
+{
+    uint32_t width, height;
+    float sourceScale;
+    bool outputRelative;
+};
+
+// Width and height share one scale. Round only at the final pixel boundary.
+// The output basis is independent of DLSS quality/DRS input dimensions.
+inline std::optional<WorkingExtent> ResolveWorkingExtent(uint32_t sourceWidth, uint32_t sourceHeight,
+    uint32_t outputWidth, uint32_t outputHeight, float scale, bool relativeToOutput)
+{
+    if (!sourceWidth || !sourceHeight) return std::nullopt;
+    if (!std::isfinite(scale)) scale = 1.0f;
+    scale = std::clamp(scale, 0.25f, 2.0f);
+    const bool useOutput = relativeToOutput && outputWidth && outputHeight;
+    const auto basisWidth = useOutput ? outputWidth : sourceWidth;
+    const auto basisHeight = useOutput ? outputHeight : sourceHeight;
+    // D3D12's 2D texture dimension limit. Uniformly reduce both axes if necessary.
+    constexpr double limit = 16384.0;
+    const double effective = std::min({ double(scale), limit / basisWidth, limit / basisHeight });
+    const auto width = uint32_t(std::max(1.0, std::floor(basisWidth * effective + 0.5)));
+    const auto height = uint32_t(std::max(1.0, std::floor(basisHeight * effective + 0.5)));
+    return WorkingExtent { width, height,
+        std::max(float(width) / sourceWidth, float(height) / sourceHeight), useOutput };
+}
+}
diff --git a/OptiScaler/hooks/ExternalFgLifetime.h b/OptiScaler/hooks/ExternalFgLifetime.h
new file mode 100644
index 0000000..95364a3
--- /dev/null
+++ b/OptiScaler/hooks/ExternalFgLifetime.h
@@ -0,0 +1,37 @@
+#pragma once
+
+#include <windows.h>
+#include <algorithm>
+#include <cwctype>
+#include <string>
+
+enum class ExternalFgRetention { Skipped, Retained, Failed };
+
+// Streamline plugins may keep interfaces implemented by sl.common across NGX initialization.
+// In external-FG mode, preserve those interfaces until process exit, without replacing them.
+inline ExternalFgRetention RetainExternalFgCommon(
+    HMODULE module, bool external,
+    decltype(&GetModuleHandleExW) retain = &GetModuleHandleExW)
+{
+    if (!external || !module || !retain)
+        return ExternalFgRetention::Skipped;
+    wchar_t buffer[MAX_PATH];
+    const auto count = GetModuleFileNameW(module, buffer, MAX_PATH);
+    if (!count || count >= MAX_PATH)
+        return ExternalFgRetention::Skipped;
+    std::wstring path(buffer, count);
+    std::transform(path.begin(), path.end(), path.begin(), [](wchar_t ch) {
+        return ch == L'/' ? L'\\' : static_cast<wchar_t>(std::towlower(ch));
+    });
+    const auto slash = path.find_last_of(L'\\');
+    const auto filename = path.substr(slash == std::wstring::npos ? 0 : slash + 1);
+    const bool common = filename == L"sl.common.dll" ||
+        (filename.ends_with(L".dll") &&
+         path.find(L"\\nvidia\\ngx\\models\\sl_common_0\\versions\\") != std::wstring::npos);
+    if (!common)
+        return ExternalFgRetention::Skipped;
+    HMODULE held = nullptr;
+    return retain(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                  reinterpret_cast<LPCWSTR>(module), &held)
+        ? ExternalFgRetention::Retained : ExternalFgRetention::Failed;
+}
