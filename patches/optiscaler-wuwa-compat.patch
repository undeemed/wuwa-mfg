diff --git a/tests/external_fg_lifetime_smoke.cpp b/tests/external_fg_lifetime_smoke.cpp
new file mode 100644
index 0000000..9278202
--- /dev/null
+++ b/tests/external_fg_lifetime_smoke.cpp
@@ -0,0 +1,44 @@
+#include "../OptiScaler/hooks/ExternalFgLifetime.h"
+#include <cassert>
+#include <filesystem>
+#include <iostream>
+
+static HMODULE Load(const std::filesystem::path& path)
+{
+    auto module = LoadLibraryW(path.c_str());
+    assert(module);
+    return module;
+}
+
+int wmain(int argc, wchar_t** argv)
+{
+    assert(argc == 2);
+    const std::filesystem::path root(argv[1]);
+    const auto common = root / "sl.common.dll";
+    auto module = Load(common);
+    assert(RetainExternalFgCommon(module, false) == ExternalFgRetention::Skipped);
+    assert(FreeLibrary(module));
+    assert(GetModuleHandleW(common.c_str()) == nullptr);
+
+    module = Load(root / "unrelated.dll");
+    assert(RetainExternalFgCommon(module, true) == ExternalFgRetention::Skipped);
+    assert(FreeLibrary(module));
+    assert(GetModuleHandleW((root / "unrelated.dll").c_str()) == nullptr);
+
+    module = Load(root / "NVIDIA/NGX/models/sl_dlss_g_0/versions/test/files/190_E658703.dll");
+    assert(RetainExternalFgCommon(module, true) == ExternalFgRetention::Skipped);
+    assert(FreeLibrary(module));
+
+    for (const auto& path : {common, root / "NVIDIA/NGX/models/sl_common_0/versions/test/files/190_E658703.dll"})
+    {
+        module = Load(path);
+        auto function = reinterpret_cast<int(*)()>(GetProcAddress(module, "ReadCommonInterface"));
+        assert(function && function() == 73);
+        assert(RetainExternalFgCommon(module, true) == ExternalFgRetention::Retained);
+        assert(FreeLibrary(module));
+        assert(GetModuleHandleW(path.c_str()) == module);
+        // The original function pointer must remain callable after the caller releases its reference.
+        assert(function() == 73);
+    }
+    std::cout << "External FG DLL lifetime: disabled/unrelated/DLSS-G exclusions and both common retention cases passed\n";
+}
