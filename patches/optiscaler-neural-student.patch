diff --git a/OptiScaler/dlssnr/DlssNr_Student.cpp b/OptiScaler/dlssnr/DlssNr_Student.cpp
new file mode 100644
index 0000000..94e169b
--- /dev/null
+++ b/OptiScaler/dlssnr/DlssNr_Student.cpp
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "pch.h"
+#include "DlssNr_Student.h"
+#include "DlssNr_DispatchSlots.h"
+#include "DlssNr_Status.h"
+#include "student/StudentRuntime.h"
+#include <Config.h>
+#include <Util.h>
+#include <fstream>
+#include <mutex>
+
+namespace DlssNr {
+struct StudentEngine::Job {
+    std::mutex mutex;
+    std::unique_ptr<student::Runtime> runtime;
+    std::array<std::unique_ptr<student::Runtime::Slot>,3> slots;
+    DispatchSlots<3> availability;
+    std::string error;
+    bool complete=false;
+    struct Start { std::shared_ptr<Job> job; Microsoft::WRL::ComPtr<ID3D12Device> device; std::filesystem::path path; HMODULE module; };
+    static DWORD WINAPI Load(void* pointer) {
+        auto start=std::unique_ptr<Start>(static_cast<Start*>(pointer));
+        try {
+            auto runtime=std::make_unique<student::Runtime>(start->device.Get(),start->path);
+            auto slot=runtime->makeSlot();
+            std::lock_guard lock(start->job->mutex);
+            start->job->runtime=std::move(runtime); start->job->slots[0]=std::move(slot);
+            start->job->complete=true;
+        } catch(const std::exception& error) {
+            std::lock_guard lock(start->job->mutex); start->job->error=error.what(); start->job->complete=true;
+        } catch(...) {
+            std::lock_guard lock(start->job->mutex); start->job->error="Student initialization failed"; start->job->complete=true;
+        }
+        // The worker owns a module reference, but never waits for the rendering thread.
+        HMODULE module=start->module; start.reset(); FreeLibraryAndExitThread(module,0);
+    }
+};
+bool StudentEngine::Ready(ID3D12Device* device,unsigned width,unsigned height,unsigned passes,
+                          const Proxy::Settings& settings,std::string& status) {
+    if (width!=1920 || height!=1080) { status="NVIDIA fallback: student needs 1920 x 1080 (50% of 4K)."; return false; }
+    const Proxy::Settings trained{0,1,1.f,1.f,1.f,-1.f,true};
+    if (passes!=1 || settings!=trained) {
+        status="NVIDIA fallback: student needs one Natural pass with default model controls."; return false;
+    }
+    if (!job) {
+        job=std::make_shared<Job>();
+        auto start=std::make_unique<Job::Start>(); start->job=job; start->device=device;
+        start->path=Util::DllPath().parent_path()/"neural-student";
+        if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,reinterpret_cast<LPCWSTR>(&Job::Load),&start->module)) {
+            job->complete=true; job->error="Cannot retain integration module during initialization";
+        } else {
+            HANDLE worker=CreateThread(nullptr,0,&Job::Load,start.get(),0,nullptr);
+            if (worker) { start.release(); CloseHandle(worker); }
+            else { FreeLibrary(start->module); job->complete=true; job->error="Cannot start student initialization"; }
+        }
+    }
+    std::lock_guard lock(job->mutex);
+    if (!job->complete) { status="Preparing student; NVIDIA is active."; return false; }
+    if (!job->error.empty()) { status="NVIDIA fallback: "+job->error; return false; }
+    status="Student ready - 1920 x 1080."; return true;
+}
+bool StudentEngine::Run(ID3D12GraphicsCommandList* commands,ID3D12Resource* input,ID3D12Resource* output,
+                        GpuLifetime& lifetime,std::string& status) {
+    if (!job) return false;
+    std::lock_guard lock(job->mutex);
+    if (!job->runtime || !job->error.empty()) return false;
+    auto allocation=job->availability.Acquire();
+    if (!allocation) { status="NVIDIA fallback: student GPU slots are still in use."; return false; }
+    try {
+        auto& slot=job->slots[allocation->index];
+        if (!slot) slot=job->runtime->makeSlot();
+        lifetime.Record(commands);
+        lifetime.Retire([done=allocation->completion]{done->store(true);});
+        if (!job->runtime->record(commands,*slot,input,output)) {
+            status="NVIDIA fallback: unsupported student texture format."; return false;
+        }
+        status="Student active - 1920 x 1080."; return true;
+    } catch(const std::exception& error) {
+        job->error=error.what(); status="Student stopped: "+job->error;
+        LOG_ERROR("DLSS-NR student: {}",job->error); return false;
+    }
+}
+void StudentEngine::Retire(GpuLifetime& lifetime) {
+    if (!job) return;
+    // Do not release a compiled graph, heap, or tensor still referenced by an unsubmitted/replayed list.
+    // GpuLifetime deliberately abandons unresolved callbacks at teardown.
+    auto retained=new std::shared_ptr<Job>(std::move(job));
+    lifetime.Retire([retained]{delete retained;});
+}
+void PollStudentRequest() {
+    static std::mutex mutex; std::lock_guard lock(mutex);
+    static uint64_t next=0; const auto now=GetTickCount64(); if(now<next) return; next=now+250;
+    auto path=Util::DllPath().parent_path()/"neural-engine.request";
+    std::ifstream file(path); if(!file) return;
+    std::string engine; std::getline(file,engine); file.close();
+    if(engine=="student" || engine=="nvidia") {
+        Config::Instance()->DlssNrEngine=uint32_t(engine=="student");
+        LOG_INFO("DLSS-NR engine requested: {}",engine);
+    }
+    else if (engine=="reload") { ReloadStudent(); LOG_INFO("DLSS-NR student reload requested"); }
+    std::error_code error; std::filesystem::remove(path,error);
+}
+}
